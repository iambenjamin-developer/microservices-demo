# =====================================================================================
# microservices-demo — environment variables for docker-compose
#
#   1. Copy this file:   cp .env.example .env
#   2. Fill in the values marked as REQUIRED.
#   3. Never commit .env (it is git-ignored).
#
# When running with Aspire (dotnet run --project src/AppHost) this file is NOT used:
# Aspire parameters are stored in .NET user-secrets of the AppHost project
# (the same secrets.json that Visual Studio opens with "Manage User Secrets").
#
# .NET settings use the "Section__Key" convention (double underscore = ":" in appsettings.json).
# =====================================================================================

# ---- PostgreSQL ---------------------------------------------------------------------
POSTGRES_USER=postgres
# REQUIRED
POSTGRES_PASSWORD=

# ---- Azure Service Bus emulator -----------------------------------------------------
# REQUIRED. Password of the SQL Server container used internally by the emulator.
# Must satisfy SQL Server complexity rules (8+ chars, upper, lower, digit, symbol).
SERVICEBUS_SQL_PASSWORD=
# The emulator always uses this fixed development key.
SERVICEBUS_CONNECTION=Endpoint=sb://servicebus-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;

# ---- JWT (Gateway issues tokens, services validate them) ----------------------------
Jwt__Issuer=microservices-demo
Jwt__Audience=microservices-demo
# REQUIRED. Symmetric signing key, at least 32 characters.
Jwt__SigningKey=

# ---- Demo users (Gateway /auth/token) -----------------------------------------------
DemoUsers__PointOfSale__Username=bar
# REQUIRED
DemoUsers__PointOfSale__Password=
# Recipient of order emails. Set it to a real inbox to receive them (e.g. your Gmail).
DemoUsers__PointOfSale__Email=bar@example.com
DemoUsers__Admin__Username=admin
# REQUIRED
DemoUsers__Admin__Password=

# ---- Email (Notifications function) -------------------------------------------------
# false => NoOpEmailSender (nothing is sent)
Email__Enabled=true
Email__From=no-reply@microservices-demo.local
Email__FromDisplayName=Beer Ordering Demo

# Option A (default): Mailpit captures every email locally — UI on http://localhost:8025
Email__Host=mailpit
Email__Port=1025
Email__UseStartTls=false
Email__Username=
Email__Password=

# Option B: real delivery through Gmail. Requires 2-Step Verification and an App Password
# (https://myaccount.google.com/apppasswords). Replace the Option A values with:
# Email__Host=smtp.gmail.com
# Email__Port=587
# Email__UseStartTls=true
# Email__Username=your.address@gmail.com
# Email__Password=your-16-char-app-password
# Email__From=your.address@gmail.com
