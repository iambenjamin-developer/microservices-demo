# =====================================================================================
# microservices-demo — environment variables for docker-compose
#
#   1. Copy this file:   cp .env.example .env
#   2. Fill in the values marked REQUIRED.
#   3. Never commit .env (it is git-ignored).
#
# Running with Aspire (dotnet run --project src/AppHost) does NOT use this file: Aspire parameters
# live in the .NET user-secrets of the AppHost project (the same secrets.json Visual Studio opens
# with "Manage User Secrets"), and Aspire generates the ones it can on first run.
#
# docker-compose.yml maps these variables to the settings the services read, so the deployment
# values stay in one place and each service block shows which settings it actually needs.
# =====================================================================================

# ---- PostgreSQL ---------------------------------------------------------------------
POSTGRES_USER=postgres
# REQUIRED
POSTGRES_PASSWORD=
# Host port, only so you can connect with psql or a GUI. Change it if 5432 is already taken.
POSTGRES_PORT=5432

# ---- Azure Service Bus --------------------------------------------------------------
# Option A (default): the local emulator. The "emulator" profile starts it and its SQL Server.
COMPOSE_PROFILES=emulator
# REQUIRED with Option A. Password of the SQL Server container the emulator stores its state in.
# It must satisfy SQL Server complexity rules (8+ characters, upper, lower, digit, symbol).
SERVICEBUS_SQL_PASSWORD=

# Option B: a real Azure namespace (Standard tier: Basic has no topics). It needs the topology first:
#   - provisioned by Aspire: run the AppHost once with the "https-azure" launch profile (see README),
#     then read the key of the send/listen "compose" policy it creates:
#       az servicebus namespace authorization-rule keys list --resource-group <rg> \
#         --namespace-name <namespace> --name compose --query primaryConnectionString -o tsv
#   - created by hand in the portal: apply the topology once with tools/servicebus-provision.cs, and
#     use a policy with Send + Listen here (never the RootManageSharedAccessKey).
# The connection string must point at the namespace: drop any ";EntityPath=..." suffix.
# Replace the Option A values with:
# COMPOSE_PROFILES=
# SERVICEBUS_CONNECTION=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=compose;SharedAccessKey=<key>

# ---- JWT ----------------------------------------------------------------------------
# REQUIRED. Symmetric HS256 signing key, at least 32 characters. The Gateway signs tokens with it
# and every service validates them with it, so it is the one value all of them must agree on.
# Generate one with:  openssl rand -base64 48
JWT_SIGNING_KEY=

# The demo account passwords are deliberately NOT here: they are demo credentials, not secrets,
# and they live in the Gateway's appsettings.json so the repository runs for anyone who clones it.

# ---- Web ----------------------------------------------------------------------------
# The Gateway address as seen by the browser (baked into the bundle at build time). The host port
# it is served on (4173) is fixed in docker-compose.yml because the Gateway allows a fixed list of
# CORS origins.
VITE_GATEWAY_URL=http://localhost:5100

# ---- Email (Notifications function) -------------------------------------------------
# false registers the Null Object sender: the notification is still stored, nothing is sent.
EMAIL_ENABLED=true
EMAIL_FROM=no-reply@microservices-demo.local

# Option A (default): Mailpit captures every e-mail locally — UI on http://localhost:8025
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_STARTTLS=false
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Option B: real delivery through Gmail. Needs 2-Step Verification and an App Password
# (https://myaccount.google.com/apppasswords). Replace the Option A values with:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_STARTTLS=true
# EMAIL_USERNAME=your.address@gmail.com
# EMAIL_PASSWORD=your-16-char-app-password
# EMAIL_FROM=your.address@gmail.com
#
# The recipient is the e-mail claim of the signed-in account (DemoUsers:bar:Email in the Gateway's
# appsettings.json). Point it at a real inbox to receive the order e-mails.
