{
  "info": {
    "name": "Catalog API",
    "description": "Catalog service endpoints (phase 2). Requests are ordered so the whole collection can be run top to bottom with the Collection Runner or newman: queries first, then commands that create and update their own test product (seed data is never modified).\n\nBase URL: `{{catalogBaseUrl}}` (defaults to the Aspire launch profile, `http://localhost:5101`). Every error response is RFC 9457 `application/problem+json`.\n\n**Sign in first.** Every service validates the JWT the Gateway issues, so the collection starts by calling `{{gatewayBaseUrl}}/auth/token` and sends the token as a bearer token on every request. Demo accounts (password `demo`): `bar` and `market` (role `PointOfSale`), `admin` (role `Admin`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gatewayBaseUrl", "value": "http://localhost:5100" },
    { "key": "catalogBaseUrl", "value": "http://localhost:5101" },
    { "key": "productId", "value": "" },
    { "key": "createdProductId", "value": "" },
    { "key": "createdSku", "value": "" },
    { "key": "accessToken", "value": "" },
    { "key": "adminToken", "value": "" }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Shared helper: every non-2xx response must be a ProblemDetails body with a trace id.",
          "if (pm.response.code >= 400) {",
          "    pm.test('Error is RFC 9457 ProblemDetails with traceId', () => {",
          "        pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
          "        const problem = pm.response.json();",
          "        pm.expect(problem.status).to.eql(pm.response.code);",
          "        pm.expect(problem).to.have.property('traceId');",
          "    });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Sign in",
      "description": "Tokens come from the Gateway; Catalog only validates them.",
      "item": [
        {
          "name": "Get point of sale token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const token = pm.response.json();",
                  "pm.test('Role is PointOfSale', () => pm.expect(token.role).to.eql('PointOfSale'));",
                  "pm.collectionVariables.set('accessToken', token.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"bar\",\n  \"password\": \"demo\"\n}" },
            "url": {
              "raw": "{{gatewayBaseUrl}}/auth/token",
              "host": ["{{gatewayBaseUrl}}"],
              "path": ["auth", "token"]
            },
            "description": "Reading the catalog only needs an authenticated caller."
          }
        },
        {
          "name": "Get admin token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const token = pm.response.json();",
                  "pm.test('Role is Admin', () => pm.expect(token.role).to.eql('Admin'));",
                  "pm.collectionVariables.set('adminToken', token.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"demo\"\n}" },
            "url": {
              "raw": "{{gatewayBaseUrl}}/auth/token",
              "host": ["{{gatewayBaseUrl}}"],
              "path": ["auth", "token"]
            },
            "description": "Creating and updating products needs the Admin role."
          }
        }
      ]
    },
    {
      "name": "Products - queries",
      "item": [
        {
          "name": "List products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const products = pm.response.json();",
                  "pm.test('Returns the seeded catalog ordered by name', () => {",
                  "    pm.expect(products).to.be.an('array').that.is.not.empty;",
                  "    const names = products.map(p => p.name);",
                  "    pm.expect(names).to.eql([...names].sort((a, b) => a.localeCompare(b)));",
                  "});",
                  "pm.test('Includes the Duff-Style Classic Lager', () => {",
                  "    pm.expect(products.map(p => p.sku)).to.include('DUFF-STYLE-CLASSIC-350');",
                  "});",
                  "pm.collectionVariables.set('productId', products[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{catalogBaseUrl}}/api/products",
              "host": ["{{catalogBaseUrl}}"],
              "path": ["api", "products"]
            },
            "description": "Lists the whole catalog ordered by name. Saves the first product id into `productId`."
          }
        },
        {
          "name": "List products filtered by SKU",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns only the requested SKUs (case-insensitive)', () => {",
                  "    const skus = pm.response.json().map(p => p.sku).sort();",
                  "    pm.expect(skus).to.eql(['AMBER-ALE-600', 'GOLDEN-LAGER-350']);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{catalogBaseUrl}}/api/products?sku=golden-lager-350&sku=AMBER-ALE-600",
              "host": ["{{catalogBaseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "sku", "value": "golden-lager-350" },
                { "key": "sku", "value": "AMBER-ALE-600" }
              ]
            },
            "description": "Repeat `sku` to request several products in one call (max 100). Ordering uses this to snapshot prices."
          }
        },
        {
          "name": "List products - too many SKUs (400)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const query = Array.from({ length: 101 }, (_, i) => `sku=SKU-${i}`).join('&');",
                  "pm.request.url.addQueryParams(query);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Reports the Skus field', () => pm.expect(pm.response.json().errors).to.have.property('Skus'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{catalogBaseUrl}}/api/products",
              "host": ["{{catalogBaseUrl}}"],
              "path": ["api", "products"]
            },
            "description": "The pre-request script builds a query with 101 `sku` values to trigger the validation filter."
          }
        },
        {
          "name": "Get product by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns the requested product', () => {",
                  "    const product = pm.response.json();",
                  "    pm.expect(product.id).to.eql(pm.collectionVariables.get('productId'));",
                  "    pm.expect(product).to.include.all.keys('sku', 'name', 'style', 'volumeMl', 'packSize', 'price');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{catalogBaseUrl}}/api/products/{{productId}}",
              "host": ["{{catalogBaseUrl}}"],
              "path": ["api", "products", "{{productId}}"]
            },
            "description": "Uses `productId` saved by *List products*."
          }
        },
        {
          "name": "Get product by id - not found (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Carries the domain error code', () => pm.expect(pm.response.json().code).to.eql('Products.NotFound'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{catalogBaseUrl}}/api/products/00000000-0000-0000-0000-000000000001",
              "host": ["{{catalogBaseUrl}}"],
              "path": ["api", "products", "00000000-0000-0000-0000-000000000001"]
            }
          }
        }
      ]
    },
    {
      "name": "Products - commands",
      "description": "POST/PUT require the `Admin` role, so these requests use `adminToken`. There is no DELETE endpoint, so each run leaves one `POSTMAN-TEST-*` product in the local database.",
      "item": [
        {
          "name": "Create product",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Unique SKU per run so the collection can be executed repeatedly.",
                  "pm.collectionVariables.set('createdSku', `POSTMAN-TEST-${Date.now()}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const product = pm.response.json();",
                  "pm.test('Location header points to the new product', () => {",
                  "    pm.expect(pm.response.headers.get('Location')).to.include(`/api/products/${product.id}`);",
                  "});",
                  "pm.test('SKU is normalized and style parsed case-insensitively', () => {",
                  "    pm.expect(product.sku).to.eql(pm.collectionVariables.get('createdSku'));",
                  "    pm.expect(product.style).to.eql('Ipa');",
                  "});",
                  "pm.collectionVariables.set('createdProductId', product.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"{{createdSku}}\",\n  \"name\": \"Postman Pale Ale 355ml\",\n  \"style\": \"ipa\",\n  \"volumeMl\": 355,\n  \"packSize\": 12,\n  \"price\": 20.50\n}"
            },
            "url": {
              "raw": "{{catalogBaseUrl}}/api/products",
              "host": ["{{catalogBaseUrl}}"],
              "path": ["api", "products"]
            },
            "description": "`style` accepts any `BeerStyle` name, case-insensitive: Lager, Pilsner, Wheat, AmberAle, Ipa, Stout. `price` is per pack.",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{adminToken}}", "type": "string" }
              ]
            }
          }
        },
        {
          "name": "Create product - duplicate SKU (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('Carries the domain error code', () => pm.expect(pm.response.json().code).to.eql('Products.SkuAlreadyExists'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"{{createdSku}}\",\n  \"name\": \"Duplicate\",\n  \"style\": \"Lager\",\n  \"volumeMl\": 355,\n  \"packSize\": 12,\n  \"price\": 10\n}"
            },
            "url": {
              "raw": "{{catalogBaseUrl}}/api/products",
              "host": ["{{catalogBaseUrl}}"],
              "path": ["api", "products"]
            },
            "description": "Reuses the SKU created by *Create product*.",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{adminToken}}", "type": "string" }
              ]
            }
          }
        },
        {
          "name": "Create product - validation errors (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Reports every invalid field at once', () => {",
                  "    pm.expect(pm.response.json().errors).to.include.all.keys('Sku', 'Name', 'Style', 'VolumeMl', 'PackSize', 'Price');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"bad sku!\",\n  \"name\": \"\",\n  \"style\": \"Porter\",\n  \"volumeMl\": 10,\n  \"packSize\": 0,\n  \"price\": 1.234\n}"
            },
            "url": {
              "raw": "{{catalogBaseUrl}}/api/products",
              "host": ["{{catalogBaseUrl}}"],
              "path": ["api", "products"]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{adminToken}}", "type": "string" }
              ]
            }
          }
        },
        {
          "name": "Create product - malformed JSON (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 400, not 500', () => pm.response.to.have.status(400));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{ \"sku\": " },
            "url": {
              "raw": "{{catalogBaseUrl}}/api/products",
              "host": ["{{catalogBaseUrl}}"],
              "path": ["api", "products"]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{adminToken}}", "type": "string" }
              ]
            }
          }
        },
        {
          "name": "Update product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Fields are updated and the SKU is unchanged', () => {",
                  "    const product = pm.response.json();",
                  "    pm.expect(product.price).to.eql(22.9);",
                  "    pm.expect(product.packSize).to.eql(24);",
                  "    pm.expect(product.sku).to.eql(pm.collectionVariables.get('createdSku'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Pale Ale 355ml\",\n  \"style\": \"Ipa\",\n  \"volumeMl\": 355,\n  \"packSize\": 24,\n  \"price\": 22.90\n}"
            },
            "url": {
              "raw": "{{catalogBaseUrl}}/api/products/{{createdProductId}}",
              "host": ["{{catalogBaseUrl}}"],
              "path": ["api", "products", "{{createdProductId}}"]
            },
            "description": "Updates the product created by *Create product*. The SKU is immutable and not part of the body.",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{adminToken}}", "type": "string" }
              ]
            }
          }
        },
        {
          "name": "Update product - not found (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Carries the domain error code', () => pm.expect(pm.response.json().code).to.eql('Products.NotFound'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ghost Lager\",\n  \"style\": \"Lager\",\n  \"volumeMl\": 350,\n  \"packSize\": 12,\n  \"price\": 10\n}"
            },
            "url": {
              "raw": "{{catalogBaseUrl}}/api/products/00000000-0000-0000-0000-000000000001",
              "host": ["{{catalogBaseUrl}}"],
              "path": ["api", "products", "00000000-0000-0000-0000-000000000001"]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{adminToken}}", "type": "string" }
              ]
            }
          }
        },
        {
          "name": "Create product as point of sale (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 403', () => pm.response.to.have.status(403));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"POSTMAN-FORBIDDEN\",\n  \"name\": \"Never Created Lager 350ml\",\n  \"style\": \"Lager\",\n  \"volumeMl\": 350,\n  \"packSize\": 12,\n  \"price\": 10\n}"
            },
            "url": {
              "raw": "{{catalogBaseUrl}}/api/products",
              "host": ["{{catalogBaseUrl}}"],
              "path": ["api", "products"]
            },
            "description": "Uses the collection token (`PointOfSale`): authenticated, but not allowed to change the catalog."
          }
        }
      ]
    },
    {
      "name": "Operations",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Reports Healthy', () => pm.expect(pm.response.text()).to.eql('Healthy'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{catalogBaseUrl}}/health",
              "host": ["{{catalogBaseUrl}}"],
              "path": ["health"]
            },
            "description": "Readiness (all checks, including the database). Development only.",
            "auth": { "type": "noauth" }
          }
        },
        {
          "name": "OpenAPI document",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Documents the products routes', () => pm.expect(pm.response.json().paths).to.have.property('/api/products'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{catalogBaseUrl}}/openapi/v1.json",
              "host": ["{{catalogBaseUrl}}"],
              "path": ["openapi", "v1.json"]
            },
            "description": "Interactive reference UI (Scalar): `{{catalogBaseUrl}}/scalar/v1`. Development only.",
            "auth": { "type": "noauth" }
          }
        },
        {
          "name": "List products - no token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Asks for a bearer token', () => pm.expect(pm.response.headers.get('WWW-Authenticate')).to.include('Bearer'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{catalogBaseUrl}}/api/products",
              "host": ["{{catalogBaseUrl}}"],
              "path": ["api", "products"]
            },
            "description": "Catalog validates the token itself, so calling it directly without one fails the same way as through the Gateway."
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{accessToken}}", "type": "string" }
    ]
  }
}
