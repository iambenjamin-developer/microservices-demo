{
  "info": {
    "name": "Ordering API",
    "description": "Ordering service endpoints (phase 4). Requests are ordered so the whole collection can be run top to bottom with the Collection Runner or newman: commands first (they create a fresh order), then queries that read it.\n\nBase URL: `{{orderingBaseUrl}}` (defaults to the Aspire launch profile, `http://localhost:5102`). Catalog must be running: prices are snapshotted from it. Every error response is RFC 9457 `application/problem+json`.\n\n**Customer identity:** it comes from the `sub` and `email` claims of the access token, never from the request. The collection signs in as `bar`; *Get order by id - another customer* signs in as `market` to show that one point of sale cannot read another one's order.\n\n**Catalog down (503):** stop the `catalog` resource in the Aspire dashboard and send *Place order*: after the retries of the resilience pipeline the API answers `503` with code `Catalog.Unavailable`; repeated calls fail fast while the circuit is open.\n\n**Sign in first.** Every service validates the JWT the Gateway issues, so the collection starts by calling `{{gatewayBaseUrl}}/auth/token` and sends the token as a bearer token on every request. Demo accounts (password `demo`): `bar` and `market` (role `PointOfSale`), `admin` (role `Admin`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gatewayBaseUrl", "value": "http://localhost:5100" },
    { "key": "orderingBaseUrl", "value": "http://localhost:5102" },
    { "key": "orderId", "value": "" },
    { "key": "accessToken", "value": "" },
    { "key": "otherToken", "value": "" }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Shared helper: every non-2xx response must be a ProblemDetails body with a trace id.",
          "if (pm.response.code >= 400) {",
          "    pm.test('Error is RFC 9457 ProblemDetails with traceId', () => {",
          "        pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
          "        const problem = pm.response.json();",
          "        pm.expect(problem.status).to.eql(pm.response.code);",
          "        pm.expect(problem).to.have.property('traceId');",
          "    });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Sign in",
      "description": "Tokens come from the Gateway; Ordering only validates them.",
      "item": [
        {
          "name": "Get point of sale token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const token = pm.response.json();",
                  "pm.test('Identifies the bar', () => pm.expect(token.username).to.eql('bar'));",
                  "pm.collectionVariables.set('accessToken', token.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"bar\",\n  \"password\": \"demo\"\n}" },
            "url": {
              "raw": "{{gatewayBaseUrl}}/auth/token",
              "host": ["{{gatewayBaseUrl}}"],
              "path": ["auth", "token"]
            },
            "description": "The point of sale that places the orders of this run."
          }
        },
        {
          "name": "Get another point of sale token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const token = pm.response.json();",
                  "pm.collectionVariables.set('otherToken', token.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"market\",\n  \"password\": \"demo\"\n}" },
            "url": {
              "raw": "{{gatewayBaseUrl}}/auth/token",
              "host": ["{{gatewayBaseUrl}}"],
              "path": ["auth", "token"]
            },
            "description": "A second point of sale, used to prove one customer cannot read another one's order."
          }
        }
      ]
    },
    {
      "name": "Orders - commands",
      "item": [
        {
          "name": "Place order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 202 Accepted', () => pm.response.to.have.status(202));",
                  "const order = pm.response.json();",
                  "pm.test('Location header points to the new order', () => {",
                  "    pm.expect(pm.response.headers.get('Location')).to.include(`/api/orders/${order.id}`);",
                  "});",
                  "pm.test('Order is Pending for the calling customer', () => {",
                  "    pm.expect(order.status).to.eql('Pending');",
                  "    pm.expect(order.customerId).to.eql('bar');",
                  "    pm.expect(order.completedOnUtc).to.be.null;",
                  "});",
                  "pm.test('Prices come from Catalog and SKUs are normalized', () => {",
                  "    const lager = order.items.find(i => i.sku === 'GOLDEN-LAGER-350');",
                  "    pm.expect(lager).to.include({ productName: 'Golden Lager 350ml', unitPrice: 12, quantity: 10, lineTotal: 120 });",
                  "});",
                  "pm.test('25 packs reach the 5% volume discount tier', () => {",
                  "    pm.expect(order.subtotal).to.eql(534);",
                  "    pm.expect(order.discount).to.eql(26.7);",
                  "    pm.expect(order.total).to.eql(507.3);",
                  "    pm.expect(order.currency).to.eql('USD');",
                  "});",
                  "pm.collectionVariables.set('orderId', order.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"sku\": \"golden-lager-350\", \"quantity\": 10 },\n    { \"sku\": \"AMBER-ALE-600\", \"quantity\": 15 }\n  ]\n}"
            },
            "url": {
              "raw": "{{orderingBaseUrl}}/api/orders",
              "host": ["{{orderingBaseUrl}}"],
              "path": ["api", "orders"]
            },
            "description": "Only SKUs and quantities (packs) are sent; names and prices are snapshotted from Catalog. The order is saved as `Pending` together with an `OrderPlaced` outbox message, and becomes `Confirmed`/`Rejected` once Inventory answers (phase 5). Saves the id into `orderId`."
          }
        },
        {
          "name": "Place order - unknown SKU (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Names the SKU missing from the catalog', () => {",
                  "    const problem = pm.response.json();",
                  "    pm.expect(problem.code).to.eql('Orders.UnknownProducts');",
                  "    pm.expect(problem.detail).to.include('GHOST-BEER-1');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"sku\": \"GOLDEN-LAGER-350\", \"quantity\": 1 },\n    { \"sku\": \"GHOST-BEER-1\", \"quantity\": 1 }\n  ]\n}"
            },
            "url": {
              "raw": "{{orderingBaseUrl}}/api/orders",
              "host": ["{{orderingBaseUrl}}"],
              "path": ["api", "orders"]
            },
            "description": "Nothing is saved: the SKU check happens before the aggregate is created."
          }
        },
        {
          "name": "Place order - validation errors (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Reports every invalid field at once', () => {",
                  "    const problem = pm.response.json();",
                  "    pm.expect(problem.code).to.eql('Validation.Failed');",
                  "    pm.expect(problem.errors).to.include.all.keys('Items[0].Sku', 'Items[0].Quantity', 'Items[1].Quantity');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"sku\": \"golden lager!\", \"quantity\": 0 },\n    { \"sku\": \"AMBER-ALE-600\", \"quantity\": 1001 }\n  ]\n}"
            },
            "url": {
              "raw": "{{orderingBaseUrl}}/api/orders",
              "host": ["{{orderingBaseUrl}}"],
              "path": ["api", "orders"]
            },
            "description": "Validation runs in the application layer (`ValidationDecorator`), before Catalog is called. Quantity must be 1–1000 packs."
          }
        },
        {
          "name": "Place order - duplicate SKUs (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Rejects the same SKU twice, ignoring case', () => pm.expect(pm.response.json().errors).to.have.property('Items'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"sku\": \"GOLDEN-LAGER-350\", \"quantity\": 1 },\n    { \"sku\": \"golden-lager-350\", \"quantity\": 2 }\n  ]\n}"
            },
            "url": {
              "raw": "{{orderingBaseUrl}}/api/orders",
              "host": ["{{orderingBaseUrl}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "Place order - no items (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Reports the Items field', () => pm.expect(pm.response.json().errors).to.have.property('Items'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"items\": []\n}" },
            "url": {
              "raw": "{{orderingBaseUrl}}/api/orders",
              "host": ["{{orderingBaseUrl}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "Place order - malformed JSON (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 400 (binding error, not 500)', () => pm.response.to.have.status(400));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{ \"items\": [ { \"sku\": " },
            "url": {
              "raw": "{{orderingBaseUrl}}/api/orders",
              "host": ["{{orderingBaseUrl}}"],
              "path": ["api", "orders"]
            }
          }
        }
      ]
    },
    {
      "name": "Orders - queries",
      "item": [
        {
          "name": "Get order by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const order = pm.response.json();",
                  "pm.test('Returns the order placed by this run with its items', () => {",
                  "    pm.expect(order.id).to.eql(pm.collectionVariables.get('orderId'));",
                  "    pm.expect(order.items).to.have.lengthOf(2);",
                  "    pm.expect(order.total).to.eql(507.3);",
                  "});",
                  "pm.test('Status is one of the order states', () => {",
                  "    pm.expect(['Pending', 'Confirmed', 'Rejected']).to.include(order.status);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{orderingBaseUrl}}/api/orders/{{orderId}}",
              "host": ["{{orderingBaseUrl}}"],
              "path": ["api", "orders", "{{orderId}}"]
            },
            "description": "Uses `orderId` saved by *Place order*. Poll this request to follow `Pending → Confirmed | Rejected` once Inventory exists (phase 5)."
          }
        },
        {
          "name": "Get order by id - another customer (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404 (existence is not revealed)', () => pm.response.to.have.status(404));",
                  "pm.test('Carries the domain error code', () => pm.expect(pm.response.json().code).to.eql('Orders.NotFound'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{orderingBaseUrl}}/api/orders/{{orderId}}",
              "host": ["{{orderingBaseUrl}}"],
              "path": ["api", "orders", "{{orderId}}"]
            },
            "description": "The same order id, read with the token of another point of sale: the API answers 404, not 403, so it does not reveal that the order exists.",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{otherToken}}", "type": "string" }
              ]
            }
          }
        },
        {
          "name": "Get order by id - not found (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Carries the domain error code', () => pm.expect(pm.response.json().code).to.eql('Orders.NotFound'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{orderingBaseUrl}}/api/orders/00000000-0000-0000-0000-000000000001",
              "host": ["{{orderingBaseUrl}}"],
              "path": ["api", "orders", "00000000-0000-0000-0000-000000000001"]
            }
          }
        },
        {
          "name": "List orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const orders = pm.response.json();",
                  "pm.test('Most recent first: this run\\'s order leads the list', () => {",
                  "    pm.expect(orders).to.be.an('array').that.is.not.empty;",
                  "    pm.expect(orders[0].id).to.eql(pm.collectionVariables.get('orderId'));",
                  "});",
                  "pm.test('Summary rows carry item count and total, not items', () => {",
                  "    pm.expect(orders[0]).to.include({ itemCount: 2, total: 507.3, currency: 'USD' });",
                  "    pm.expect(orders[0]).to.not.have.property('items');",
                  "});",
                  "pm.test('Every row belongs to the signed in customer', () => {",
                  "    pm.expect(orders.every(o => o.customerId === undefined || o.customerId === 'bar')).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{orderingBaseUrl}}/api/orders",
              "host": ["{{orderingBaseUrl}}"],
              "path": ["api", "orders"]
            },
            "description": "The signed in customer's orders, most recent first (max 100). Orders of previous runs stay in the list: the account is fixed now that identity comes from the token."
          }
        },
        {
          "name": "List orders - no token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 401', () => pm.response.to.have.status(401));"]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{orderingBaseUrl}}/api/orders",
              "host": ["{{orderingBaseUrl}}"],
              "path": ["api", "orders"]
            },
            "description": "Without a token there is no customer to list orders for."
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{accessToken}}", "type": "string" }
    ]
  }
}
